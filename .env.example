# ─── Firebase Web App (client) — from Firebase Console → Project settings → Your apps
# Project: md-sifat-e-book

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=md-sifat-e-book.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=md-sifat-e-book
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=md-sifat-e-book.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Realtime Database URL — Firebase Console → Realtime Database (copy exact URL)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://md-sifat-e-book-default-rtdb.firebaseio.com

# Where e-book emails are stored (default: ebookLeads)
NEXT_PUBLIC_FIREBASE_EBOOK_LEADS_PATH=ebookLeads

# ─── Optional: Firebase Admin (server) — service account for API-only saves
# FIREBASE_DATABASE_URL=https://md-sifat-e-book-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_PROJECT_ID=md-sifat-e-book
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_EBOOK_LEADS_PATH=ebookLeads

# ─── Security (production)
# Use Firebase Admin above + publish database.rules.production.json (blocks client writes).
# Dev only — allow browser writes when Admin is not set (NOT for production):
# EBOOK_INSECURE_CLIENT_FALLBACK=true
